# Copy to server/config.env for local development.
# On Render, set these in the service Environment dashboard.

NODE_ENV=development
PORT=5000

# Required in production
JWT_SECRET=your-long-random-secret-here
MONGODB_URI=mongodb://localhost:27017/gifted-giving

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend URL (email links, CORS)
CLIENT_URL=http://localhost:5173

# Optional CORS extras (comma-separated)
# ALLOWED_ORIGINS=https://www.giftedgivings.com
# ALLOWED_ORIGIN_PATTERNS=^https://gifted-givings-[^.]+\.vercel\.app$

# Email (required for donor email verification / password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=your-email@gmail.com

# Optional — used when generating upload URLs
# API_BASE_URL=https://your-api.onrender.com

# Required when running scripts/seedAdmin.js in production (never logged)
# ADMIN_SEED_PASSWORD=your-secure-admin-password

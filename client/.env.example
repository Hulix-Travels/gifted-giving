# Copy to .env.local for development or set in Vercel for production builds.

# API (optional in dev — Vite proxies /api to localhost:5000)
# VITE_API_URL=http://localhost:5000/api

# Required for production builds (npm run build). Use pk_test_... locally, pk_live_... in production.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# Public site URL for Open Graph / social previews (no trailing slash)
# VITE_SITE_URL=https://www.giftedgivings.com
